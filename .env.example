# API keys stay on the Python backend. Never use NEXT_PUBLIC_ for secrets.
QUOTE_GATEWAY_URL=
QUOTE_GATEWAY_KEY=
# Optional absolute path; defaults to data/monitor.sqlite3
# DATABASE_PATH=/absolute/path/monitor.sqlite3
# Local MOCK gateway example (requires scripts/dev.sh --gateway):
# QUOTE_GATEWAY_URL=http://127.0.0.1:8010

FRONTEND_PORT=3000
BACKEND_PORT=8000
GATEWAY_PORT=8010

# Futu OpenD GUI: log in locally; no passwords are stored in this app.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# Daily retention (worker, 08:00 America/New_York): keep N exchange trading days of
# raw/result/status/outbox rows. 1 = current trading day only (default), 0 = disabled.
# RETENTION_DAYS=1
# No automatic VACUUM. To reclaim disk: stop worker+API, then
#   sqlite3 data/monitor.sqlite3 'PRAGMA wal_checkpoint(TRUNCATE); VACUUM;'
